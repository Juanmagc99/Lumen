# PostgreSQL settings for the local Lumen database.
LUMEN_POSTGRES_USER=lumen
LUMEN_POSTGRES_DB=lumen
LUMEN_POSTGRES_PORT=5432
# Reuse the existing password for a shared volume.
LUMEN_POSTGRES_PASSWORD=

# Optional initial administrator for a local demo; set both in the ignored .env.
LUMEN_ADMIN_USERNAME=
LUMEN_ADMIN_PASSWORD=

# Decision model for the worker. Supply a LiteLLM model identifier and a local provider key.
LUMEN_DECISION_MODEL=
LUMEN_DECISION_API_KEY=
LUMEN_DECISION_TIMEOUT_SECONDS=60

# Independent response drafting model; keep credentials in the ignored .env file.
LUMEN_RESPONSE_MODEL=
LUMEN_RESPONSE_API_KEY=
LUMEN_RESPONSE_TIMEOUT_SECONDS=60
LUMEN_EMBEDDING_MODEL=text-embedding-3-small
LUMEN_EMBEDDING_DIMENSIONS=1536
LUMEN_EMBEDDING_API_KEY=
LUMEN_EMBEDDING_TIMEOUT_SECONDS=30
LUMEN_RESPONSE_CONCURRENCY=2
LUMEN_RESPONSE_RATE_LIMIT=20
LUMEN_RESPONSE_RATE_WINDOW_SECONDS=60
LUMEN_RESPONSE_MAX_ATTEMPTS=3
LUMEN_RESPONSE_RETRY_SECONDS=10
LUMEN_RESPONSE_QUEUE_LIMIT=100
LUMEN_KNOWLEDGE_MAX_BYTES=1048576

# Optional development server ports.
LUMEN_API_PORT=8000
LUMEN_WEB_PORT=5173
